      <thead><tr><th scope="col">Trip</th><th scope="col">4 hours</th><th scope="col">6 hours</th><th scope="col">8 hours</th></tr></thead>
      <tbody>{% for r in prices %}<tr><th scope="row">{{ r.trip }}</th><td>{{ r.h4 }}</td><td>{{ r.h6 }}</td><td>{{ r.h8 }}</td></tr>{% endfor %}</tbody>
    </table></div>
    <p style="margin:16px 0 0">Book more than one tarpon trip and save $50 on each. Gift cards in any amount work for any trip. <a href="{{ site.giftCards }}" style="color:#fff;font-weight:700">Buy a gift card</a></p>
  </div>
</section>

