        </div>
      </article>
    {% endfor %}
    </div>
    <div class="chips"><p>After one fish in particular?</p>
      <a class="chip" href="/redfish/">Redfish</a><a class="chip" href="/snook/">Snook</a><a class="chip" href="/tarpon/">Tarpon</a><a class="chip" href="/grouper/">Grouper</a><a class="chip" href="/shark/">Shark</a>
    </div>
  </div>
</section>

<section class="band-navy section">
  <div class="wrap">
    <div class="head-row">
      <div><h2>Tampa Bay fishing charter prices</h2>
      <p class="sub-lead" style="margin:0">Prices are per boat, not per person. Your captain, rods, reels, tackle, bait and <strong>fishing licenses</strong> are included.</p></div>
      <a class="btn btn-accent" href="{{ site.booking }}" target="_blank" rel="noopener">Reserve a Date</a>
    </div>
